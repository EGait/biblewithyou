# Get a free key at https://aistudio.google.com/apikey
# Leave blank to run in demo mode (keyword matching, no AI).
GEMINI_API_KEY=

# Pick a free tier Flash Lite model from AI Studio. This alias tracks the latest one.
GEMINI_MODEL=gemini-flash-lite-latest

# Free requests per user per day
DAILY_LIMIT=10

# Signs Plus unlock cookies. Make a long random string:  openssl rand -base64 48
UNLOCK_SECRET=

# Solana Pay (USDC). Your wallet address that receives payments.
SOLANA_MERCHANT_WALLET=
# A reliable RPC (Helius free tier works). Public RPC is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Stripe card payments. Use test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# Your live site URL, e.g. https://biblewithyou.com (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=

# Donations: percent that goes to the cause (rest supports development)
DONATION_CAUSE_PCT=50
CAUSE_NAME=a charity or local church (announced soon)
